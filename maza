name: Build MAZA exe

on:
  workflow_dispatch:
  push:
    tags: ["v*"]          # məs.: git tag v1.0.0 && git push --tags  -> Release-ə MAZA.exe əlavə olunur

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest
    env:
      PYTHONUTF8: "1"
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Asılılıqlar
        run: pip install -r requirements.txt pyinstaller

      - name: Tüstü testi (idxal, hesabatlar, HTTP)
        run: python -I tests/smoke_test.py

      - name: exe yarat
        run: pyinstaller --onefile --name MAZA --noupx debitor_kreditor.py

      - uses: actions/upload-artifact@v4
        with:
          name: MAZA-windows
          path: dist/MAZA.exe

      - name: Release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/MAZA.exe
